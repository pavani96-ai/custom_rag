# Copy to .env (make env does this) and replace every placeholder. Never commit .env.
POSTGRES_PASSWORD=change-me
JINA_API_KEY=

# Local Gemini generation. For Vertex AI, set the project and use Application Default Credentials.
GEMINI_API_KEY=
# GEMINI_MODEL answers questions in the RAG API. GEMINI_JUDGE_MODEL grades evals; keep it different.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_JUDGE_MODEL=gemini-4-hydrogen
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Browser origins allowed to call the API (comma-separated). Defaults cover the local web app.
WEB_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Workspace the web app creates collections in. Local dev fixture; Milestone 2 replaces this with login.
NEXT_PUBLIC_WORKSPACE_ID=00000000-0000-4000-8000-000000000002

# Local database web tools (pgAdmin at http://127.0.0.1:5050). Choose your own login.
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=
